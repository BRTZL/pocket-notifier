# @import(../../apps/server/, pick=[NODE_ENV, CORS_ORIGIN, BETTER_AUTH_SECRET])
# @defaultRequired=false
# @defaultSensitive=true
# ---
# Encrypts secrets in Alchemy's deploy state. Must match the ALCHEMY_PASSWORD GitHub secret.
ALCHEMY_PASSWORD=

# Cloudflare API token used for deploys (scoped to the Bartu OZEL account and bartuozel.com).
CLOUDFLARE_API_TOKEN=

# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# Firebase service-account JSON (one line) for FCM pushes.
FCM_SERVICE_ACCOUNT=
