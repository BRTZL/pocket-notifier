{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@notifier/api": "workspace:*",
    "@notifier/auth": "workspace:*",
    "@notifier/db": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.19",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@notifier/config": "workspace:*",
    "@notifier/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
