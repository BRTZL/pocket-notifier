# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The deployment's public origin, without a path (better-auth adds its `/api/auth`
# basePath). Local: http://localhost:3300. Production: https://notifier.bartuozel.com
# @type=url
BETTER_AUTH_URL=

# The origin allowed credentialed CORS; invite links are built on it. Usually the same
# origin as BETTER_AUTH_URL.
# @type=url
CORS_ORIGIN=

# Firebase service-account key JSON, on one line, for FCM push. Optional: without it
# push is disabled and publishing still works. Wrap it in single quotes in .env.
# @optional @sensitive @type=string
FCM_SERVICE_ACCOUNT=
