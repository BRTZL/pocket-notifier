{
  "name": "notifier",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:generate": "turbo run db:generate -F @notifier/db --",
    "deploy": "turbo run deploy -F @notifier/infra --",
    "destroy": "turbo run destroy -F @notifier/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "check": "biome check --write .",
    "lint": "biome ci .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "catalog:",
    "@notifier/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
